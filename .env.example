# Hindsight Cloud Memory Bank
HINDSIGHT_API_KEY=hs_live_example_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=rapport-client-memory

# Groq LLM API
GROQ_API_KEY=gsk_example_key_here
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b

# Timeouts & Retries
HTTP_TIMEOUT_SECONDS=10.0
LLM_MAX_RETRIES=3

# Database
SQLITE_DB_PATH=rapport.db
