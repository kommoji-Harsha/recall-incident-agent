# Provider Selection
LLM_PROVIDER=groq

# Hindsight Configuration
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=recall-incidents

# Groq LLM Configuration (Default provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b

# OpenAI LLM Configuration (Optional unless LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_PRIMARY_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4.1-mini

# Timeouts & Limits
HINDSIGHT_TIMEOUT_SECONDS=15.0
GROQ_TIMEOUT_SECONDS=30.0

# Database
SQLITE_DB_PATH=recall.db
